@page
@model Uniflow.Pages.Courses.UploadMaterialModel
@{
    ViewData["Title"] = "Încarcă Material";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="glass-card p-4">
                <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary">
                    <i class="hgi-stroke hgi-upload-01 hgi-2x me-3 text-primary"></i>
                    <div>
                        <h2 class="mb-1 fw-bold">Încarcă Material</h2>
                        <h5 class="text-muted mb-0">pentru cursul: <span class="fw-bold text-light">@Model.Course?.Title</span></h5>
                    </div>
                </div>
                
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Input.File" class="form-label fw-bold text-muted">Selectați Fișier</label>
                        <input asp-for="Input.File" class="form-control" type="file" />
                        <span asp-validation-for="Input.File" class="text-danger"></span>
                        <small class="text-muted d-block mt-1"><i class="hgi-stroke hgi-information-circle"></i> Mărime maximă acceptată: 50 MB</small>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Description" class="form-label fw-bold text-muted">Descriere (opțional)</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="3" 
                                  placeholder="Adăugați o descriere pentru acest material..."></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-page="./Details" asp-route-id="@Model.Course?.Id" class="btn btn-outline-secondary">
                            <i class="hgi-stroke hgi-arrow-left-01"></i> Înapoi la Curs
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="hgi-stroke hgi-upload-01 me-2"></i> Încarcă Fișier
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

