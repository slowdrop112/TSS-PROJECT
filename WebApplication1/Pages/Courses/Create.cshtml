@page
@model Uniflow.Pages.Courses.CreateModel
@{
    ViewData["Title"] = "Creează Curs Nou";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="glass-card p-4">
                <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary">
                    <i class="hgi-stroke hgi-add-01 hgi-2x me-3 text-primary"></i>
                    <h2 class="mb-0 fw-bold">Creează Curs Nou</h2>
                </div>
                
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Course.Title" class="form-label fw-bold text-muted">Titlu Curs</label>
                        <input asp-for="Course.Title" class="form-control" placeholder="Introduceți titlul cursului" />
                        <span asp-validation-for="Course.Title" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Course.Description" class="form-label fw-bold text-muted">Descriere</label>
                        <textarea asp-for="Course.Description" class="form-control" rows="5" placeholder="Introduceți descrierea cursului"></textarea>
                        <span asp-validation-for="Course.Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="hgi-stroke hgi-arrow-left-01"></i> Înapoi la Listă
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="hgi-stroke hgi-checkmark-circle-01 me-2"></i> Salvează Curs
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}





