@page
@model Uniflow.Pages.Notes.IndexModel
@{
    ViewData["Title"] = "Notițele Mele";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-light fw-bold"><i class="hgi-stroke hgi-note me-2"></i> Notițele Mele</h1>
        <a asp-page="Create" class="btn btn-primary px-4 py-2">
            <i class="hgi-stroke hgi-add-01 me-2"></i> Creează Notiță
        </a>
    </div>

    <!-- Căutare -->
    <div class="glass-card mb-4 p-4">
        <form method="get" class="row g-3">
            <div class="col-md-10">
                <input type="text" class="form-control" name="SearchString" value="@Model.SearchString" placeholder="Caută în notițe..." />
                <input type="hidden" name="Tab" value="@Model.Tab" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100 h-100" type="submit">
                    <i class="hgi-stroke hgi-search-01 me-2"></i> Caută
                </button>
            </div>
        </form>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-pills mb-4 gap-2" role="tablist">
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "my" || string.IsNullOrEmpty(Model.Tab) ? "active" : "text-muted")" 
               asp-page="Index" asp-route-tab="my" asp-route-searchString="@Model.SearchString">
               <i class="hgi-stroke hgi-user me-2"></i> Mele (@Model.MyNotes.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "shared" ? "active" : "text-muted")" 
               asp-page="Index" asp-route-tab="shared" asp-route-searchString="@Model.SearchString">
               <i class="hgi-stroke hgi-share-01 me-2"></i> Partajate (@Model.SharedWithMe.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == "all" ? "active" : "text-muted")" 
               asp-page="Index" asp-route-tab="all" asp-route-searchString="@Model.SearchString">
               <i class="hgi-stroke hgi-grid-01 me-2"></i> Toate (@Model.AllNotes.Count)
            </a>
        </li>
    </ul>

    <!-- Conținut Tab -->
    <div class="tab-content">
        @if (Model.Tab == "my" || string.IsNullOrEmpty(Model.Tab))
        {
            <div class="tab-pane fade show active">
                @if (Model.MyNotes.Any())
                {
                    <div class="row g-4">
                        @foreach (var note in Model.MyNotes)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card neuro-card h-100 border-0">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <h5 class="card-title fw-bold mb-0 text-truncate">
                                                <a asp-page="Details" asp-route-id="@note.Id" class="text-decoration-none text-light">@note.Title</a>
                                            </h5>
                                            <span class="badge bg-@(note.Status == "Approved" ? "success" : note.Status == "Rejected" ? "danger" : "warning") rounded-pill">
                                                @note.Status
                                            </span>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <small class="text-muted d-block"><i class="hgi-stroke hgi-book-01 me-1"></i> @note.CourseTitle</small>
                                            <small class="text-muted d-block"><i class="hgi-stroke hgi-calendar-01 me-1"></i> @note.CreatedDate.ToString("dd.MM.yyyy")</small>
                                        </div>

                                        <p class="card-text text-light flex-grow-1" style="opacity: 0.8;">
                                            @(note.Content.Length > 80 ? note.Content.Substring(0, 80) + "..." : note.Content)
                                        </p>

                                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary">
                                            <div class="d-flex align-items-center gap-3">
                                                <span class="text-success"><i class="hgi-stroke hgi-thumbs-up"></i> @note.Upvotes</span>
                                                <span class="text-danger"><i class="hgi-stroke hgi-thumbs-down"></i> @note.Downvotes</span>
                                            </div>
                                            <div class="btn-group">
                                                <a asp-page="Edit" asp-route-id="@note.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="hgi-stroke hgi-pencil-edit-01"></i>
                                                </a>
                                                <a asp-page="Delete" asp-route-id="@note.Id" class="btn btn-sm btn-outline-danger">
                                                    <i class="hgi-stroke hgi-delete-01"></i>
                                                </a>
                                                <a asp-page="Details" asp-route-id="@note.Id" class="btn btn-sm btn-primary">
                                                    <i class="hgi-stroke hgi-arrow-right-01"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info glass-card border-0">
                        <i class="hgi-stroke hgi-information-circle me-2"></i> Nu ai notițe create încă.
                    </div>
                }
            </div>
        }

        @if (Model.Tab == "shared")
        {
            <div class="tab-pane fade show active">
                @if (Model.SharedWithMe.Any())
                {
                    <div class="row g-4">
                        @foreach (var note in Model.SharedWithMe)
                        {
                             <div class="col-md-6 col-lg-4">
                                <div class="card neuro-card h-100 border-0">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <h5 class="card-title fw-bold mb-0 text-truncate">
                                                <a asp-page="Details" asp-route-id="@note.Id" class="text-decoration-none text-light">@note.Title</a>
                                            </h5>
                                            <span class="badge bg-info rounded-pill">Partajat</span>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <small class="text-muted d-block"><i class="hgi-stroke hgi-book-01 me-1"></i> @note.CourseTitle</small>
                                            <small class="text-muted d-block"><i class="hgi-stroke hgi-user me-1"></i> De: @note.OwnerName</small>
                                        </div>

                                        <p class="card-text text-light flex-grow-1" style="opacity: 0.8;">
                                            @(note.Content.Length > 80 ? note.Content.Substring(0, 80) + "..." : note.Content)
                                        </p>

                                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary">
                                            <div class="d-flex align-items-center gap-3">
                                                <span class="text-success"><i class="hgi-stroke hgi-thumbs-up"></i> @note.Upvotes</span>
                                                <span class="text-danger"><i class="hgi-stroke hgi-thumbs-down"></i> @note.Downvotes</span>
                                            </div>
                                            <a asp-page="Details" asp-route-id="@note.Id" class="btn btn-sm btn-primary">
                                                Vezi Detalii <i class="hgi-stroke hgi-arrow-right-01 ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info glass-card border-0">
                        <i class="hgi-stroke hgi-information-circle me-2"></i> Nu ai notițe partajate cu tine.
                    </div>
                }
            </div>
        }

        @if (Model.Tab == "all")
        {
            <div class="tab-pane fade show active">
                @if (Model.AllNotes.Any())
                {
                    <div class="row g-4">
                        @foreach (var note in Model.AllNotes)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card neuro-card h-100 border-0">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <h5 class="card-title fw-bold mb-0 text-truncate">
                                                <a asp-page="Details" asp-route-id="@note.Id" class="text-decoration-none text-light">@note.Title</a>
                                            </h5>
                                            <span class="badge bg-@(note.Status == "Approved" ? "success" : note.Status == "Rejected" ? "danger" : "warning") rounded-pill">
                                                @note.Status
                                            </span>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <small class="text-muted d-block"><i class="hgi-stroke hgi-book-01 me-1"></i> @note.CourseTitle</small>
                                            <small class="text-muted d-block"><i class="hgi-stroke hgi-user me-1"></i> @note.StudentName</small>
                                        </div>

                                        <p class="card-text text-light flex-grow-1" style="opacity: 0.8;">
                                            @(note.Content.Length > 80 ? note.Content.Substring(0, 80) + "..." : note.Content)
                                        </p>

                                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary">
                                            <div class="d-flex align-items-center justify-content-center w-100 gap-4">
                                                  <div class="d-flex flex-column align-items-center">
                                                    <a href="#" class="text-decoration-none text-success vote-btn p-1" data-note-id="@note.Id" data-vote-type="upvote">
                                                        <i class="hgi-stroke hgi-arrow-up-01"></i>
                                                    </a>
                                                    <span class="fw-bold score-@note.Id small">@note.Score</span>
                                                    <a href="#" class="text-decoration-none text-danger vote-btn p-1" data-note-id="@note.Id" data-vote-type="downvote">
                                                        <i class="hgi-stroke hgi-arrow-down-01"></i>
                                                    </a>
                                                </div>
                                                <a asp-page="Details" asp-route-id="@note.Id" class="btn btn-sm btn-primary flex-grow-1">
                                                    Vezi Detalii
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info glass-card border-0">
                        <i class="hgi-stroke hgi-information-circle me-2"></i> Nu există notițe disponibile.
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Upvote/Downvote AJAX
        document.querySelectorAll('.vote-btn').forEach(btn => {
            btn.addEventListener('click', async function(e) {
                e.preventDefault();
                const noteId = this.dataset.noteId;
                const voteType = this.dataset.voteType;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                
                try {
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', token);
                    
                    const response = await fetch(`/Notes/Vote?noteId=${noteId}&voteType=${voteType}`, {
                        method: 'POST',
                        body: formData
                    });
                    
                    if (response.ok) {
                        const data = await response.json();
                        document.querySelector(`.score-${noteId}`).textContent = data.score;
                        location.reload(); // Reîncarcă pentru a actualiza voturile
                    }
                } catch (error) {
                    console.error('Eroare la vot:', error);
                }
            });
        });
    </script>
}

