@page
@model LoginModel

@{
    ViewData["Title"] = "Autentificare";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="glass-card p-5">
                <div class="text-center mb-4">
                    <div class="neuro-btn-icon rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                        <i class="hgi-stroke hgi-user-circle hgi-3x text-primary"></i>
                    </div>
                    <h2 class="text-dark fw-bold">Bine ați venit!</h2>
                    <p class="text-muted">Autentificați-vă pentru a continua</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger glass-card border-danger text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="text-muted">Email / Username</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="text-muted">Parolă</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="checkbox">
                            <label asp-for="Input.RememberMe" class="form-label text-dark mb-0">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none text-primary small">Ați uitat parola?</a>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                        <i class="hgi-stroke hgi-login-01 me-2"></i> Autentificare
                    </button>
                    
                    <div class="mt-4 text-center">
                         <span class="text-muted">Nu aveți cont?</span>
                         <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary text-decoration-none fw-bold ms-1">Înregistrați-vă</a>
                    </div>
                     <div class="mt-2 text-center">
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-muted small text-decoration-none">Retrimiteți confirmarea prin email</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}