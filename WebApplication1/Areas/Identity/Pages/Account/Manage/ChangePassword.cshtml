@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Schimbă Parola";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="text-dark mb-4 border-bottom border-secondary pb-2">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-9">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger glass-card border-danger text-danger mb-4" role="alert"></div>
            
            <div class="form-floating mb-3">
                <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your old password." />
                <label asp-for="Input.OldPassword" class="text-muted">Parola Veche</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>
            
            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please enter your new password." />
                <label asp-for="Input.NewPassword" class="text-muted">Parola Nouă</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>
            
            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please confirm your new password." />
                <label asp-for="Input.ConfirmPassword" class="text-muted">Confirmă Parola Nouă</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            
            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4 py-2">
                <i class="hgi-stroke hgi-key-01"></i> Actualizează Parola
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
