@page
@model IndexModel
@{
    ViewData["Title"] = "Setări Cont";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="text-dark mb-4 border-bottom border-secondary pb-2">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="alert alert-info glass-card border-0">
    <i class="hgi-stroke hgi-information-circle me-2"></i>
    Pentru a edita Numele și Prenumele, te rugăm să folosești <a href="/Profile" class="fw-bold">Pagina de Profil Principală</a>.
</div>

<div class="row">
    <div class="col-md-9">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger glass-card border-danger text-danger mb-4" role="alert"></div>
            
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Please choose your username." disabled />
                <label asp-for="Username" class="text-muted">Username</label>
            </div>
            
            <div class="form-floating mb-4">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number." />
                <label asp-for="Input.PhoneNumber" class="text-muted">Număr de Telefon</label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
            </div>
            
            <button id="update-profile-button" type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4 py-2">
                <i class="hgi-stroke hgi-checkmark-circle-01"></i> Salvează Modificările
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
